{
  "$id": "https://raw.githubusercontent.com/jay1459/agent-team/main/schemas/profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "defaults": {
      "default": {},
      "type": "object",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "opus",
                "sonnet",
                "haiku",
                "inherit"
              ]
            },
            {
              "type": "string",
              "pattern": "^claude-[a-z0-9][a-z0-9.-]*$",
              "description": "Full model ID"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "pm",
          "architect",
          "lead-dev",
          "developer",
          "qa",
          "uat-tester",
          "security",
          "legal",
          "presales",
          "sales"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "opus",
                  "sonnet",
                  "haiku",
                  "inherit"
                ]
              },
              {
                "type": "string",
                "pattern": "^claude-[a-z0-9][a-z0-9.-]*$",
                "description": "Full model ID"
              }
            ]
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              {
                "type": "string",
                "const": "pm-decides"
              }
            ]
          },
          "promptAppend": {
            "type": "string",
            "maxLength": 20000
          },
          "tools": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "Read",
                    "Grep",
                    "Glob",
                    "Edit",
                    "Write",
                    "Bash",
                    "WebFetch",
                    "WebSearch",
                    "NotebookEdit",
                    "TodoWrite"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^mcp__[A-Za-z0-9_-]+(__[A-Za-z0-9_*-]+)?$"
                }
              ]
            }
          }
        },
        "required": [
          "enabled"
        ]
      }
    },
    "specialists": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
              },
              {
                "type": "string",
                "pattern": "^custom:[a-z0-9]+(-[a-z0-9]+)*$"
              }
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "opus",
                  "sonnet",
                  "haiku",
                  "inherit"
                ]
              },
              {
                "type": "string",
                "pattern": "^claude-[a-z0-9][a-z0-9.-]*$",
                "description": "Full model ID"
              }
            ]
          },
          "promptAppend": {
            "type": "string",
            "maxLength": 20000
          },
          "tools": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "Read",
                    "Grep",
                    "Glob",
                    "Edit",
                    "Write",
                    "Bash",
                    "WebFetch",
                    "WebSearch",
                    "NotebookEdit",
                    "TodoWrite"
                  ]
                },
                {
                  "type": "string",
                  "pattern": "^mcp__[A-Za-z0-9_-]+(__[A-Za-z0-9_*-]+)?$"
                }
              ]
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "docs": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "mcp": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "http"
                      },
                      "url": {
                        "type": "string",
                        "format": "uri"
                      },
                      "headers": {
                        "default": {},
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9-]+$"
                        },
                        "additionalProperties": {
                          "type": "string",
                          "pattern": "^([A-Za-z]+ )?\\{env:[A-Za-z_][A-Za-z0-9_]*\\}$"
                        }
                      }
                    },
                    "required": [
                      "type",
                      "url"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "default": "stdio",
                        "type": "string",
                        "const": "stdio"
                      },
                      "command": {
                        "type": "string",
                        "minLength": 1
                      },
                      "args": {
                        "default": [],
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "env": {
                        "default": {},
                        "type": "object",
                        "propertyNames": {
                          "type": "string",
                          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                        },
                        "additionalProperties": {
                          "type": "string",
                          "pattern": "^env:[A-Za-z_][A-Za-z0-9_]*$"
                        }
                      }
                    },
                    "required": [
                      "command"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            ]
          }
        },
        "required": [
          "id",
          "enabled"
        ]
      }
    },
    "runner": {
      "default": {
        "layered": false,
        "permissionMode": "acceptEdits"
      },
      "type": "object",
      "properties": {
        "layered": {
          "default": false,
          "type": "boolean"
        },
        "maxBudgetUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "teamBudgetUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10000
        },
        "permissionMode": {
          "default": "acceptEdits",
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "plan"
          ]
        }
      },
      "additionalProperties": false
    },
    "workflow": {
      "default": {
        "humanApproval": [
          "architecture",
          "merge"
        ],
        "workspace": "team/"
      },
      "type": "object",
      "properties": {
        "humanApproval": {
          "default": [
            "architecture",
            "merge"
          ],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "requirements",
              "architecture",
              "estimate",
              "customer-facing-docs",
              "merge",
              "release"
            ]
          }
        },
        "workspace": {
          "default": "team/",
          "type": "string",
          "pattern": "^(?!\\/)(?!.*(^|\\/)\\.\\.(\\/|$))[A-Za-z0-9._/-]+\\/?$"
        }
      }
    }
  },
  "required": [
    "version",
    "name",
    "roles"
  ],
  "additionalProperties": false
}
