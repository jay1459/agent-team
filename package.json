{
  "name": "agent-team-monorepo",
  "private": true,
  "description": "Configure a PM-led team of Claude Code agents from a local web UI",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run build -w @agent-team/schema && tsc -p packages/schema --noEmit && tsc -p packages/cli --noEmit",
    "schemas": "npm run build -w @agent-team/schema && node packages/schema/scripts/export-json-schema.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "yaml": "^2.9.1"
  }
}
