{
  "name": "@jay1459/agent-team",
  "version": "0.1.0",
  "description": "Run a software project with a team of Claude Code agents led by a PM, configured from a local web UI",
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "multi-agent",
    "ai",
    "project-manager",
    "mcp",
    "agent-sdk"
  ],
  "homepage": "https://github.com/jay1459/agent-team#readme",
  "bugs": {
    "url": "https://github.com/jay1459/agent-team/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jay1459/agent-team.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "Joe Hardy",
  "type": "module",
  "bin": {
    "agent-team": "./dist/cli.js"
  },
  "files": [
    "dist",
    "catalog",
    "web",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --noEmit && rm -rf dist && node scripts/bundle.mjs && node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.330"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "esbuild": "^0.28.2",
    "@agent-team/schema": "*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
